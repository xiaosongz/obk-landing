{
  "name": "obelisk-investor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "predev": "npm run images",
    "prebuild": "npm run images",
    "dev": "vite --host 127.0.0.1 --port 8766 --strictPort",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "preview": "vite preview --host 127.0.0.1 --port 8766 --strictPort",
    "snapshot:load": "node scripts/lp-snapshot-load.mjs",
    "snapshot:publish": "node scripts/lp-snapshot-publish.mjs",
    "test:fund-data": "node --test tests/fund-data.test.mjs",
    "check:worker": "tsc -p tsconfig.worker.json",
    "deploy": "npm run build && npm run check:worker && wrangler deploy"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.6.2",
    "echarts": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "wrangler": "^4.129.0"
  }
}
