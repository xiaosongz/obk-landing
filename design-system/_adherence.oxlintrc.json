{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|type|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: title, description, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|error)$/]",
        "message": "<Alert> type must be one of 'info' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|arrow|icon|href|onClick|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, arrow, icon, href, onClick, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|default|bronze|inverse|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'default' | 'bronze' | 'inverse' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapitalStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|note|style|key|ref|className|style|children)$/]",
        "message": "<CapitalStrip> doesn't accept that prop. Declared props: items, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Collapse'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|ghost|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Collapse> doesn't accept that prop. Declared props: label, children, ghost, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|rowKey|emptyText|footer|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, rowKey, emptyText, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Descriptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|bordered|columns|style|key|ref|className|style|children)$/]",
        "message": "<Descriptions> doesn't accept that prop. Declared props: items, bordered, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|inverse|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, accent, inverse, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|span)$/]",
        "message": "<Eyebrow> as must be one of 'p' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow-right|arrow-left|lock|mail|search|environment|home|file-text)$/]",
        "message": "<Icon> name must be one of 'arrow-right' | 'arrow-left' | 'lock' | 'mail' | 'search' | 'environment' | 'home' | 'file-text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|search|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, search, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvestorCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|text|cta|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<InvestorCallout> doesn't accept that prop. Declared props: eyebrow, title, text, cta, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManagerNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|style|key|ref|className|style|children)$/]",
        "message": "<ManagerNote> doesn't accept that prop. Declared props: eyebrow, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|metrics|style|key|ref|className|style|children)$/]",
        "message": "<MetricGroup> doesn't accept that prop. Declared props: title, metrics, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|caption|pending|style|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, caption, pending, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|onClose|closeLabel|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, onClose, closeLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|aside|style|key|ref|className|style|children)$/]",
        "message": "<PageTitle> doesn't accept that prop. Declared props: eyebrow, title, intro, aside, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|address|location|status|rent|href|framed|cta|style|key|ref|className|style|children)$/]",
        "message": "<PhotoCard> doesn't accept that prop. Declared props: src, address, location, status, rent, href, framed, cta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortalLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|href|style|key|ref|className|style|children)$/]",
        "message": "<PortalLink> doesn't accept that prop. Declared props: eyebrow, title, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PreviewNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<PreviewNotice> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|tagline|href|style|key|ref|className|style|children)$/]",
        "message": "<ProcessCard> doesn't accept that prop. Declared props: number, title, description, tagline, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|level|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, intro, level, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|portalHref|onNavigate|contactHref|status|year|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: tagline, portalHref, onNavigate, contactHref, status, year, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onNavigate|previewBar|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: items, active, onNavigate, previewBar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SourceNote> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageJumps'] > JSXAttribute > JSXIdentifier[name!=/^(?:stages|hrefBase|style|key|ref|className|style|children)$/]",
        "message": "<StageJumps> doesn't accept that prop. Declared props: stages, hrefBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|arrow|inverse|underline|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, arrow, inverse, underline, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:inverse|small|size|href|as|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: inverse, small, size, href, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:a|div|span)$/]",
        "message": "<Wordmark> as must be one of 'a' | 'div' | 'span'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
